# ---- server ----
PORT=2567
# Postgres (docker-compose provides this on localhost:5432)
DATABASE_URL=postgres://codeshoot:codeshoot@localhost:5432/codeshoot

# Better Auth
BETTER_AUTH_SECRET=change-me-with-a-long-random-string
BETTER_AUTH_URL=http://localhost:2567
# Web origin allowed to call the API / connect to Colyseus
WEB_ORIGIN=http://localhost:5173

# Optional GitHub OAuth (dev audience). Leave blank to use email/password only.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Piston (untrusted code sandbox) — API base, including the version segment.
# Self-hosted (docker-compose, Linux prod): http://localhost:2000/api/v2
# Dev on Windows (Docker Desktop can't run Piston — no cgroup v2): use the
# public instance: https://emkc.org/api/v2/piston
PISTON_URL=http://localhost:2000/api/v2
# JS runtime version the self-hosted Piston instance hosts (see README).
PISTON_NODE_VERSION=20.11.1
# DEV-ONLY escape hatch: judge in a local node child process instead of
# Piston (Docker Desktop on Windows can't run Piston). NEVER "true" in prod.
JUDGE_LOCAL_FALLBACK=false

# ---- web ----
VITE_SERVER_URL=http://localhost:2567
VITE_COLYSEUS_URL=ws://localhost:2567
