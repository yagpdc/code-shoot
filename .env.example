# ---- server ----
PORT=2567
# Postgres (docker-compose provides this on localhost:5432)
DATABASE_URL=postgres://codeshoot:codeshoot@localhost:5432/codeshoot

# Better Auth
BETTER_AUTH_SECRET=change-me-with-a-long-random-string
BETTER_AUTH_URL=http://localhost:2567
# Web origin allowed to call the API / connect to Colyseus
WEB_ORIGIN=http://localhost:5173

# Optional GitHub OAuth (dev audience). Leave blank to use email/password only.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Piston (untrusted code sandbox) — docker-compose provides this
PISTON_URL=http://localhost:2000
# Node package version installed into Piston (see README "Piston setup")
PISTON_NODE_VERSION=20.11.1

# ---- web ----
VITE_SERVER_URL=http://localhost:2567
VITE_COLYSEUS_URL=ws://localhost:2567
